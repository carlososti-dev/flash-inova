# Copie para .env e ajuste.
# A aplicação conecta com o usuário sem privilégios (o RLS vale para ele).
DATABASE_URL=postgresql+psycopg://flash_app:flash_app@localhost:5433/flash_inova
# As migrações rodam com o dono das tabelas.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://flash_owner:flash_owner@localhost:5433/flash_inova
APP_DB_ROLE=flash_app

# Em produção: chave aleatória longa, cookie seguro, subdomínios reais e sem troca de hospital por parâmetro.
SECRET_KEY=troque-esta-chave-em-producao-antes-de-publicar
COOKIE_SECURE=false
BASE_DOMAIN=localhost
ALLOW_TENANT_OVERRIDE=true
EMAIL_BACKEND=console
